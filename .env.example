# Shelly Cloud server host and key: web app https://control.shelly.cloud >
# Settings > Home tab > Access & permissions > Cloud key > Get key
# (e.g. shelly-42-eu.shelly.cloud)
SHELLY_SERVER=shelly-XX-eu.shelly.cloud
# Cloud keys, one per home (recommended): key1[@server];key2[@server]
# Server defaults to SHELLY_SERVER. Home names are detected from the cloud;
# list them with `shelly-monitor homes`, rename with `homes --name KEY_ID NAME`.
SHELLY_AUTH_KEYS=
# Optional fixed names for some keys (win over detection): Name=key[@server];Other=key2
#SHELLY_HOMES=Montagna=KEY2
# Single key setup of 0.1/0.2 (still supported)
#SHELLY_AUTH_KEY=
# Fixed name for SHELLY_AUTH_KEY; also the name of data in databases older than 0.3
#SHELLY_HOME_NAME=home
# Seconds between two cloud requests, all homes together (default 5, minimum 1.1:
# the cloud allows at most 1 request/second per account). Keep
# homes x 5 x SHELLY_REQUEST_GAP below SHELLY_INTERVAL (hourly refresh cycle).
SHELLY_REQUEST_GAP=5
# SQLite database path
SHELLY_DB=./shelly-monitor.db
# SQLite journal: wal (default) or delete. Use delete when the database is on a network
# filesystem (SMB/CIFS, NFS, cloud file shares): WAL needs shared memory those do not provide.
#SHELLY_DB_JOURNAL=wal
# Polling interval in seconds (one all_status request per home per cycle)
SHELLY_INTERVAL=60
# 1 = also read the cloud activity log every cycle (one more request per home); 0 = off
SHELLY_EVENT_LOG=1
# Automatic backups written by the poller (run and serve --poll) after a successful cycle:
# shelly-monitor-YYYYmmdd-HHMMSS.db.gz in this folder (empty = off). Interval in hours
# (0 = after every successful cycle) and how many files to keep.
#SHELLY_BACKUP_DIR=./backups
#SHELLY_BACKUP_INTERVAL_HOURS=24
#SHELLY_BACKUP_KEEP=14
# Largest backup accepted by the dashboard restore upload, in MB
#SHELLY_RESTORE_MAX_MB=200
# DEBUG, INFO, WARNING, ERROR
SHELLY_LOG_LEVEL=INFO
# Web dashboard (shelly-monitor serve; `serve --poll` also runs the poller in the same process).
# Without a password there is no authentication: keep 127.0.0.1 unless it sits behind a
# reverse proxy with its own login. GET /healthz is always public.
SHELLY_HTTP_HOST=127.0.0.1
SHELLY_HTTP_PORT=8787
# 1 = the dashboard refuses every write (custom groups are then managed with the CLI only)
SHELLY_WEB_READONLY=0
# Built-in password login (optional): set ONE of the two. The plain password is hashed with
# scrypt at startup; a hash (scrypt$N$r$p$salt_hex$hash_hex) can be made with
#   python3 -c "from shelly_monitor.auth import hash_password; print(hash_password(input()))"
#SHELLY_WEB_PASSWORD=
#SHELLY_WEB_PASSWORD_HASH=
# Cookie signing key, hex (at least 32 hex chars), e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# Unset: random at every start, so every session ends when the process restarts.
#SHELLY_WEB_COOKIE_SECRET=
# Session lifetime in days (1-365)
#SHELLY_WEB_SESSION_DAYS=7
# 1 = behind a trusted reverse proxy: client IP from X-Forwarded-For (login rate limit) and
# https from X-Forwarded-Proto (Secure cookie). Never set it when the port is reachable directly.
#SHELLY_WEB_TRUST_PROXY=0
# 1 = always mark the session cookie Secure (the dashboard is only reached over https)
#SHELLY_WEB_SECURE_COOKIE=0
