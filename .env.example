# Shelly Cloud server host and key: web app https://control.shelly.cloud >
# Settings > Home tab > Access & permissions > Cloud key > Get key
# (e.g. shelly-42-eu.shelly.cloud)
SHELLY_SERVER=shelly-XX-eu.shelly.cloud
# Cloud keys, one per home (recommended): key1[@server];key2[@server]
# Server defaults to SHELLY_SERVER. Home names are detected from the cloud;
# list them with `shelly-monitor homes`, rename with `homes --name KEY_ID NAME`.
SHELLY_AUTH_KEYS=
# Optional fixed names for some keys (win over detection): Name=key[@server];Other=key2
#SHELLY_HOMES=Montagna=KEY2
# Single key setup of 0.1/0.2 (still supported)
#SHELLY_AUTH_KEY=
# Fixed name for SHELLY_AUTH_KEY; also the name of data in databases older than 0.3
#SHELLY_HOME_NAME=home
# Seconds between two cloud requests, all homes together (default 5, minimum 1.1:
# the cloud allows at most 1 request/second per account). Keep
# homes x 5 x SHELLY_REQUEST_GAP below SHELLY_INTERVAL (hourly refresh cycle).
SHELLY_REQUEST_GAP=5
# SQLite database path
SHELLY_DB=./shelly-monitor.db
# Polling interval in seconds (one all_status request per home per cycle)
SHELLY_INTERVAL=60
# 1 = also read the cloud activity log every cycle (one more request per home); 0 = off
SHELLY_EVENT_LOG=1
# DEBUG, INFO, WARNING, ERROR
SHELLY_LOG_LEVEL=INFO
# Web dashboard (shelly-monitor serve). No authentication: keep 127.0.0.1
# unless it sits behind a reverse proxy with auth.
SHELLY_HTTP_HOST=127.0.0.1
SHELLY_HTTP_PORT=8787
# 1 = the dashboard refuses every write (custom groups are then managed with the CLI only)
SHELLY_WEB_READONLY=0
